# Copy this file to `.streamlit/secrets.toml` and fill in real values.
# `.streamlit/secrets.toml` is git-ignored and must NEVER be committed.
#
# Streamlit loads these values automatically via `st.secrets`.

# --- Company details (optional; defaults are used when omitted) ---------------
COMPANY_NAME = "Sairow Solutions"
COMPANY_ADDRESS = "Gilgit-Baltistan, Pakistan"
COMPANY_PHONE = "+92-XXX-XXXXXXX"
COMPANY_EMAIL = "info@sairowsolutionsgb.com"
COMPANY_WEBSITE = "www.sairowsolutionsgb.com"

# Optional: override the logo path shown on the PDF.
# INVOICE_LOGO_PATH = "assets/SairowSolutionsGB logo.jpg"

# --- Payment accounts (sensitive) --------------------------------------------
# Each account appears in the "Payment Information" table on the invoice.
# Add one [[payment_accounts]] block per account. Leave this section out
# entirely to omit the payment table from generated invoices.
#
# [[payment_accounts]]
# account_holder = "Full Name"
# method = "Easypaisa"
# details = "03000000000"
#
# [[payment_accounts]]
# account_holder = "Full Name"
# method = "Meezan Bank"
# details = "IBAN: PK00XXXX0000000000000000"
